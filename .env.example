# ── Frontend (exposed to the browser — only public values here) ──────────────
# Project URL = https://<project-ref>.supabase.co (ref is in the dashboard URL; also under "Connect")
# Key: Settings → API Keys → Publishable key (sb_publishable_...)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Server (api/ on Vercel, Vite middleware in dev) — never prefix with VITE_ ─
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Settings → API Keys → Secret keys (sb_secret_..., click the eye to reveal, then copy)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated emails allowed to use the admin API (empty = any logged-in user)
ADMIN_EMAILS=
# Random string (16+ letters/digits). Vercel Cron sends it to /api/cron/purge. Only needed on Vercel.
CRON_SECRET=
# Days after expiry before photos are deleted (default 3)
PURGE_GRACE_DAYS=3

# Photos live in Supabase Storage (private bucket "photos", created by supabase/schema.sql).
# No extra keys: the server uses SUPABASE_SERVICE_ROLE_KEY for storage too.
